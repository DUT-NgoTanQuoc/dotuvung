# Copy this file to .env and fill in real values. Never commit .env.

# --- Supabase Postgres ---
# Get these from your Supabase project: Project Settings > Database > Connection string.
#
# DATABASE_URL: the transaction-mode pooler (port 6543, pgbouncer=true). Used by the app at runtime.
# DIRECT_URL:   the session-mode pooler (port 5432). Used by Prisma Migrate (`prisma migrate dev/deploy`).
#
# IMPORTANT: if your database password contains special characters (# @ % : / etc.),
# URL-encode them, e.g. "#" -> "%23", "@" -> "%40".
#
# Recommended region for users in Vietnam: Southeast Asia (Singapore, ap-southeast-1) —
# pair it with Vercel's "sin1" function region (see vercel.json) to minimize DB latency.
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- NextAuth (Admin login) ---
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
# In production, set this to your deployed URL (e.g. https://dotuvung.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
